# Copiez ce modèle en .env : l'application charge ce fichier automatiquement.
# Gardez .env et les secrets en local ; ne versionnez que ce modèle sans secrets.
PRICE_MONITOR_HOST=127.0.0.1
PRICE_MONITOR_PORT=8080
PRICE_MONITOR_ENV=development
PRICE_MONITOR_LOG_LEVEL=INFO
PRICE_MONITOR_SERVICE_NAME=price-monitor
# Individual accounts are required for shared/public deployments. Bootstrap
# the first administrator with price-monitor-users bootstrap --username NAME.
PRICE_MONITOR_TEAM_MODE=false
# HTTPS origin without a path, e.g. https://prices.example.com. Required in production.
PRICE_MONITOR_PUBLIC_ORIGIN=
# Personal local development may use false; shared/public deployment requires true.
PRICE_MONITOR_SECURE_COOKIES=false
PRICE_MONITOR_SESSION_HOURS=8
PRICE_MONITOR_SESSION_IDLE_MINUTES=30
# Waitress behind a TLS reverse proxy: use https on a private/loopback backend
# or trust X-Forwarded-* only from this exact proxy IP (no wildcard).
PRICE_MONITOR_URL_SCHEME=http
PRICE_MONITOR_TRUSTED_PROXY=
# Legacy local service key. Shared deployments use individual sessions/tokens;
# this shared key never bypasses team authentication.
PRICE_MONITOR_API_KEY=
# Enabled automatically when PRICE_MONITOR_ENV=production.
PRICE_MONITOR_RATE_LIMIT_REQUESTS=60
PRICE_MONITOR_RATE_LIMIT_WINDOW_SECONDS=60
# PRICE_MONITOR_RATE_LIMIT_ENABLED=true
PRICE_MONITOR_DEMO=false
# Legacy interval applies only to Yahoo live quotes and demo data. Due initial
# collections run in the background while the app serves saved prices.
PRICE_MONITOR_COLLECTION_INTERVAL_MINUTES=1
# Provider intervals in minutes: daily publications vs monthly index vs quotes.
PRICE_MONITOR_FRED_INTERVAL_MINUTES=360
PRICE_MONITOR_EIA_INTERVAL_MINUTES=360
PRICE_MONITOR_ALPHA_VANTAGE_INTERVAL_MINUTES=720
PRICE_MONITOR_BLS_INTERVAL_MINUTES=1440
PRICE_MONITOR_YAHOO_INTERVAL_MINUTES=1
# Request caps over a rolling 24-hour window, persisted across restarts. Includes
# unsuccessful HTTP attempts and manual refreshes. Raise only for your plan.
PRICE_MONITOR_ALPHA_VANTAGE_DAILY_LIMIT=25
PRICE_MONITOR_BLS_DAILY_LIMIT=25
# Optional local caps for other providers; 0 means no configured local cap.
# PRICE_MONITOR_FRED_DAILY_LIMIT=0
# PRICE_MONITOR_EIA_DAILY_LIMIT=0
# PRICE_MONITOR_YAHOO_DAILY_LIMIT=0
# Network failures: exponential delay from 60 seconds up to six hours.
PRICE_MONITOR_COLLECTION_BACKOFF_SECONDS=60
PRICE_MONITOR_COLLECTION_MAX_BACKOFF_SECONDS=21600
# BZ/HO sessions use New York time (DST-aware), with weekends and the daily
# 17:00-18:00 break. Add official holiday/early-close windows as ISO timestamps
# with timezone offsets: [{"start":"...","end":"..."}]. See CME holiday hours.
PRICE_MONITOR_MARKET_CLOSURES=[]
# Live commodity quotes power the dashboard cards. Set false to use only the
# official daily/monthly benchmark history.
PRICE_MONITOR_LIVE_QUOTES_ENABLED=true
PRICE_MONITOR_DB_BACKEND=sqlite
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional direct EIA v2 feeds for diesel and Brent. Register a free key at
# https://www.eia.gov/opendata/ to enable these two additional data sources.
EIA_API_KEY=
# The BLS WPU058 bitumen/asphalt trend indicator is collected without an API key.
# If BLS is unavailable or rate-limited, the same official index is read from FRED.
# Optional separate monthly history; defaults beside PRICE_MONITOR_DATA.
# PRICE_MONITOR_BITUMEN_DATA=data/processed/bitumen_index.csv
# Optional price alerts. Values are JSON; use product keys gasoil, brent and bitume.
# Example: {"brent":{"above":90,"below":70},"gasoil":{"above":3.5},"bitume":{"above":600}}
PRICE_MONITOR_ALERT_THRESHOLDS=
# Teams incoming webhooks and most generic webhook endpoints accept this payload.
PRICE_MONITOR_ALERT_WEBHOOK_URL=
PRICE_MONITOR_ALERT_WEBHOOK_TIMEOUT_SECONDS=10
# Optional SMTP delivery. Multiple recipients are comma-separated.
PRICE_MONITOR_ALERT_EMAIL_TO=
PRICE_MONITOR_ALERT_SMTP_HOST=
PRICE_MONITOR_ALERT_SMTP_PORT=587
PRICE_MONITOR_ALERT_SMTP_USER=
PRICE_MONITOR_ALERT_SMTP_PASSWORD=
PRICE_MONITOR_ALERT_SMTP_FROM=
PRICE_MONITOR_ALERT_SMTP_USE_TLS=true
PRICE_MONITOR_ALERT_NOTIFY_RECOVERY=true
# One collection summary every five hours while the service is running.
# Uses the SMTP settings above; leave the recipient empty to disable it.
PRICE_MONITOR_DIGEST_EMAIL_TO=
PRICE_MONITOR_DIGEST_INTERVAL_HOURS=5
# PRICE_MONITOR_DATA=C:\\chemin\\vers\\market_prices.csv
# PRICE_MONITOR_DB=C:\\chemin\\vers\\price_monitor.db
# PRICE_MONITOR_BACKUP_DIR=C:\\chemin\\vers\\backups

# MySQL (set PRICE_MONITOR_DB_BACKEND=mysql to enable)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=price_monitor
MYSQL_USER=price_monitor
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
